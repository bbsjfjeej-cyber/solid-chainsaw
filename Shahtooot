      <br>

      <p style="color:#bbb; margin-bottom:20px;">
        عکس یا ویدیو را از گوشی انتخاب کن
      </p>

      <label for="fileInput" class="upload-label">
        انتخاب فایل
      </label>

      <input
        type="file"
        id="fileInput"
        accept="image/*,video/*"
        multiple
      >

      <div id="preview"></div>

    </div>

  </div>

