<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>🍓 SHAHTOOT 👑</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Tahoma, Arial, sans-serif;
      background:
        radial-gradient(circle at top, #47152f 0%, #160b18 35%, #08070b 75%);
      color: white;
      min-height: 100vh;
    }

    /* HEADER */
    header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(10, 7, 12, 0.85);
      backdrop-filter: blur(15px);
      border-bottom: 1px solid rgba(255,255,255,0.08);
      padding: 15px 20px;
    }

    nav {
      max-width: 1100px;
      margin: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
    }

    .logo {
      font-size: 20px;
      font-weight: bold;
      color: #ffb3d1;
      white-space: nowrap;
    }

    nav ul {
      list-style: none;
      display: flex;
      gap: 20px;
    }

    nav a {
      color: white;
      text-decoration: none;
      transition: 0.3s;
    }

    nav a:hover {
      color: #ff5c9d;
    }

    /* HERO */
    .hero {
      min-height: 85vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 40px 20px;
    }

    .hero-content {
      max-width: 850px;
    }

    .crown {
      font-size: 60px;
      animation: float 3s infinite ease-in-out;
    }

    @keyframes float {
      50% {
        transform: translateY(-12px);
      }
    }

    .hero h1 {
      margin: 20px 0;
      font-size: clamp(35px, 7vw, 70px);
      background: linear-gradient(90deg, #ff4f91, #ffd0e2, #ff4f91);
      -webkit-background-clip: text;
      color: transparent;
    }

    .hero p {
      color: #d7cbd2;
      font-size: 18px;
      line-height: 2;
    }

    .buttons {
      margin-top: 30px;
      display: flex;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .btn {
      border: none;
      text-decoration: none;
      padding: 14px 24px;
      border-radius: 30px;
      color: white;
      font-weight: bold;
      cursor: pointer;
      background: linear-gradient(135deg, #ff2f78, #9b174d);
      box-shadow: 0 10px 30px rgba(255,47,120,0.25);
      transition: 0.3s;
      display: inline-block;
    }

    .btn:hover {
      transform: translateY(-4px);
      box-shadow: 0 15px 35px rgba(255,47,120,0.4);
    }

    .btn.secondary {
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.12);
    }

    /* SECTIONS */
    section {
      max-width: 1100px;
      margin: auto;
      padding: 80px 20px;
    }

    .section-title {
      text-align: center;
      margin-bottom: 40px;
    }

    .section-title h2 {
      font-size: 32px;
      color: #ff83b1;
      margin-bottom: 10px;
    }

    .section-title p {
      color: #aaa;
    }

    /* GALLERY */
    .gallery {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 18px;
    }

    .card {
      overflow: hidden;
      border-radius: 22px;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.08);
      backdrop-filter: blur(12px);
      transition: 0.3s;
    }

    .card:hover {
      transform: translateY(-6px);
      border-color: rgba(255,92,157,0.4);
    }

    .media-box {
      height: 230px;
      background: linear-gradient(135deg, #351224, #171019);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #777;
      position: relative;
      overflow: hidden;
    }

    .media-box img,
    .media-box video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .play {
      position: absolute;
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: rgba(255,47,120,0.9);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 25px;
    }

    .card-info {
      padding: 16px;
    }

    .card-info h3 {
      margin-bottom: 7px;
      color: #fff;
    }

    .card-info p {
      color: #aaa;
      font-size: 14px;
    }

    /* TELEGRAM */
    .telegram {
      text-align: center;
      padding: 55px 20px;
      border-radius: 30px;
      background: linear-gradient(
        135deg,
        rgba(255,47,120,0.16),
        rgba(125,25,80,0.12)
      );
      border: 1px solid rgba(255,255,255,0.08);
    }

    .telegram h2 {
      font-size: 30px;
      margin-bottom: 15px;
    }

    .telegram p {
      color: #bbb;
      margin-bottom: 25px;
    }

    /* ADMIN */
    .admin {
      background: rgba(255,255,255,0.04);
      border-radius: 28px;
      padding: 30px;
      border: 1px solid rgba(255,255,255,0.08);
    }

    .upload-area {
      border: 2px dashed rgba(255,92,157,0.45);
      border-radius: 20px;
      padding: 40px 20px;
      text-align: center;
      margin-top: 20px;
      transition: 0.3s;
    }

    .upload-area:hover {
      background: rgba(255,92,157,0.06);
    }

    .upload-area input {
      display: none;
    }

    .upload-label {
      display: inline-block;
      padding: 14px 25px;
      border-radius: 30px;
      background: #ff2f78;
      cursor: pointer;
      font-weight: bold;
    }

    #preview {
      margin-top: 25px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 15px;
    }

    #preview img,
    #preview video {
      width: 100%;
      max-height: 250px;
      object-fit: cover;
      border-radius: 15px;
    }

    /* FOOTER */
    footer {
      text-align: center;
      padding: 35px 20px;
      color: #888;
      border-top: 1px solid rgba(255,255,255,0.06);
    }

    /* MOBILE */
    @media (max-width: 650px) {

      nav {
        flex-direction: column;
      }

      nav ul {
        gap: 12px;
        font-size: 13px;
      }

      .hero {
        min-height: 75vh;
      }

      section {
        padding: 60px 15px;
      }

      .media-box {
        height: 250px;
      }
    }
  </style>
</head>

<body>

<header>
