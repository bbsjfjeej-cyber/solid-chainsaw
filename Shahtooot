    </p>

  </div>

  <div class="gallery">

    <div class="card">

      <div class="media-box">
        📸 عکس شما
      </div>

      <div class="card-info">
        <h3>عکس شماره ۱</h3>
        <p>یکی از عکس‌های من ❤️</p>
      </div>

    </div>


    <div class="card">

      <div class="media-box">
        📸 عکس شما
      </div>

      <div class="card-info">
        <h3>عکس شماره ۲</h3>
        <p>یک خاطره خاص ✨</p>
      </div>

    </div>


    <div class="card">

      <div class="media-box">
        📸 عکس شما
      </div>

      <div class="card-info">
        <h3>عکس شماره ۳</h3>
